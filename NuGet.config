<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- nuget.org only, whatever feeds the machine has: with central package management more than one source is
       NU1507, and an unreachable feed fails the vulnerability audit (NU1900), both errors in Release -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
