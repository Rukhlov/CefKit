<Project>

  <!-- Shared settings: .NET 10, x64 (CEF builds for win-x64 and linux-x64) -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>CefKit contributors</Authors>
    <Copyright>Copyright (c) 2026 CefKit contributors</Copyright>
    <Product>CefKit</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Rukhlov/CefKit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Rukhlov/CefKit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Packages built in CI: deterministic paths for Source Link -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
