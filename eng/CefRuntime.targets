<Project>

  <!--
    Copies the CEF runtime next to an application of this repository (samples, tests): libcef and its resources from
    the distribution extracted by eng/fetch-cef.ps1, and the NativeAOT helper published by eng/publish-helper.ps1.
    Enable with <CefKitCopyRuntime>true</CefKitCopyRuntime> before importing. Applications outside this repository
    get the same layout from the CefKit.Runtime.<rid> packages (src/CefKit.Runtime).
  -->

  <Import Project="CefVersion.props" />

  <!-- libcef.so of the Linux distribution keeps its debug symbols (1.4 GB): the runtime files are hard links in the
       output and publish directories rather than copies (a copy across volumes) -->
  <PropertyGroup Condition="'$(CefKitCopyRuntime)' == 'true'">
    <CreateHardLinksForAdditionalFilesIfPossible>true</CreateHardLinksForAdditionalFilesIfPossible>
    <CreateHardLinksForPublishFilesIfPossible>true</CreateHardLinksForPublishFilesIfPossible>
  </PropertyGroup>

  <ItemGroup Condition="'$(CefKitCopyRuntime)' == 'true'">
    <!-- Not needed at run time: import libraries, the sandbox bootstrap executables (Windows) and the setuid sandbox
         (Linux), since CefKit runs without the Chromium sandbox -->
    <None Include="$(CefKitDistributionDir)Release\**\*"
          Exclude="$(CefKitDistributionDir)Release\**\*.lib;$(CefKitDistributionDir)Release\bootstrap*.exe;$(CefKitDistributionDir)Release\chrome-sandbox"
          Link="%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(CefKitDistributionDir)Resources\**\*"
          Link="%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(CefKitHelperDir)cefkit-helper*"
          Exclude="$(CefKitHelperDir)*.pdb;$(CefKitHelperDir)*.dbg"
          Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- CEF starts the helper for every sub-process: on Linux and macOS it must stay executable after the copy -->
  <Target Name="CefKitHelperExecutable" AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(CefKitCopyRuntime)' == 'true' and !$([MSBuild]::IsOSPlatform('Windows')) and Exists('$(OutDir)cefkit-helper')">
    <Exec Command="chmod +x &quot;$(OutDir)cefkit-helper&quot;" />
  </Target>

  <Target Name="CefKitCheckRuntime" BeforeTargets="Build" Condition="'$(CefKitCopyRuntime)' == 'true'">
    <Error Condition="!Exists('$(CefKitDistributionDir).cefkit-complete')"
           Text="CEF $(CefKitCefVersion) ($(CefKitPlatform)) is not downloaded: pwsh eng/fetch-cef.ps1" />
  </Target>

</Project>
