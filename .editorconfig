root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,props,targets,csproj,slnx,yml,yaml,xml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true

# Generated interop: names and layout follow the CEF C API
[src/CefKit/Interop/Generated/**.cs]
generated_code = true
dotnet_diagnostic.IDE1006.severity = none
